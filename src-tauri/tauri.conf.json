{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teachya",
  "version": "0.1.0",
  "identifier": "com.teachya.app",
  "build": {
    "beforeDevCommand": "npm run helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run helper && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Teachya",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/captures/**", "$APPCACHE/frames/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "externalBin": ["binaries/teachya-helper"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
